<div class="space-y-4 p-6 bg-white dark:bg-neutral-800">
  <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mb-4">Priority Badges</h3>
  
  <div class="flex flex-wrap gap-3">
    <%= render BadgeComponent.new(text: "High Priority", variant: :priority_high) %>
    <%= render BadgeComponent.new(text: "Medium Priority", variant: :priority_medium) %>
    <%= render BadgeComponent.new(text: "Low Priority", variant: :priority_low) %>
  </div>

  <h4 class="text-md font-semibold text-neutral-900 dark:text-white mt-6 mb-4">Due Date Badges</h4>
  <div class="flex flex-wrap gap-3">
    <%= render BadgeComponent.new(text: "Overdue", variant: :overdue) %>
    <%= render BadgeComponent.new(text: "Due Today", variant: :due_today) %>
    <%= render BadgeComponent.new(text: "Due Soon", variant: :due_soon) %>
  </div>
</div> 