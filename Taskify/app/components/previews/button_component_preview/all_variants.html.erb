<div class="space-y-4 p-6 bg-neutral-50 dark:bg-neutral-900">
  <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mb-4">Button Variants</h3>
  
  <div class="flex flex-wrap gap-4">
    <%= render ButtonComponent.new(variant: :primary) { "Primary" } %>
    <%= render ButtonComponent.new(variant: :secondary) { "Secondary" } %>
    <%= render ButtonComponent.new(variant: :danger) { "Danger" } %>
    <%= render ButtonComponent.new(variant: :ghost) { "Ghost" } %>
    <%= render ButtonComponent.new(variant: :success) { "Success" } %>
  </div>

  <h4 class="text-md font-semibold text-neutral-900 dark:text-white mt-8 mb-4">Disabled States</h4>
  <div class="flex flex-wrap gap-4">
    <%= render ButtonComponent.new(variant: :primary, disabled: true) { "Primary Disabled" } %>
    <%= render ButtonComponent.new(variant: :secondary, disabled: true) { "Secondary Disabled" } %>
    <%= render ButtonComponent.new(variant: :danger, disabled: true) { "Danger Disabled" } %>
  </div>
</div> 