<div class="<%= card_classes %> animate-fade-in" style="<%= animation_style %>">
  <!-- Task Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex items-center space-x-3 flex-1 min-w-0">
      <!-- Priority Indicator -->
      <div class="<%= priority_indicator_class %>"></div>
      
      <!-- Task Title -->
      <h3 class="<%= task.completed? ? 'line-through text-neutral-500 dark:text-neutral-400' : 'text-neutral-900 dark:text-white' %> font-medium text-lg truncate">
        <%= task.title %>
      </h3>
      
      <!-- Completion Status -->
      <% if task.completed? %>
        <div class="flex-shrink-0">
          <div class="w-5 h-5 bg-green-500 dark:bg-green-400 rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>
      <% end %>
    </div>
    
    <!-- Actions Menu -->
    <div class="flex items-center space-x-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <% if can_edit_task? %>
        <%= link_to edit_task_path(task), 
            class: "p-2 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-colors duration-150" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>
      <% end %>
      
      <% if can_complete_task? && !task.completed? %>
        <%= button_to complete_task_path(task), method: :patch, 
            class: "p-2 text-green-500 hover:text-green-600 dark:hover:text-green-400 rounded-lg hover:bg-green-50 dark:hover:bg-green-900/25 transition-colors duration-150",
            title: "Mark as completed",
            form: { style: "display: inline;" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Task Description -->
  <% if task.description.present? %>
    <p class="text-neutral-600 dark:text-neutral-300 text-sm mb-4 leading-relaxed">
      <%= task.description %>
    </p>
  <% end %>

  <!-- Task Metadata -->
  <div class="flex items-center justify-between text-sm">
    <!-- Left Side: Category & Assignee -->
    <div class="flex items-center space-x-4">
      <% if task.category.present? %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300">
          <%= task.category %>
        </span>
      <% end %>
      
      <% if task.assignee.present? && task.assignee != current_user %>
        <div class="flex items-center space-x-1 text-neutral-500 dark:text-neutral-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span><%= task.assignee.name %></span>
        </div>
      <% end %>
    </div>

    <!-- Right Side: Due Date -->
    <% if task.due_date.present? %>
      <div class="flex items-center space-x-1 <%= due_date_class %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="text-xs"><%= due_date_text %></span>
      </div>
    <% end %>
  </div>
</div> 