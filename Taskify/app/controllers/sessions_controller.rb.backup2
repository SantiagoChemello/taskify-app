class SessionsController < Devise::SessionsController
  skip_before_action :verify_authenticity_token, only: [:create], if: :testing_environment?
  
  protected

  # Override after_sign_in_path_for to redirect to dashboard
  def after_sign_in_path_for(resource)
    dashboard_path
  end

  private

  def testing_environment?
    Rails.env.development? && request.user_agent.to_s.include?('curl')
  end
end 