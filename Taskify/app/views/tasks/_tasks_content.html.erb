<!-- Notifications -->
<% if overdue_tasks > 0 || due_today_tasks > 0 || due_soon_tasks > 0 %>
  <div class="notifications">
    <% if overdue_tasks > 0 %>
      <div class="notification-item notification-overdue">
        <span class="icon icon-warning"></span>
        <span>Vencidas:</span>
        <strong><%= overdue_tasks %></strong>
        <span>tarea<%= 's' if overdue_tasks != 1 %></span>
      </div>
    <% end %>

    <% if due_today_tasks > 0 %>
      <div class="notification-item notification-due-today">
        <span class="icon icon-clock"></span>
        <span>Hoy:</span>
        <strong><%= due_today_tasks %></strong>
        <span>tarea<%= 's' if due_today_tasks != 1 %></span>
      </div>
    <% end %>

    <% if due_soon_tasks > 0 %>
      <div class="notification-item notification-due-soon">
        <span class="icon icon-calendar"></span>
        <span>Próximas:</span>
        <strong><%= due_soon_tasks %></strong>
        <span>tarea<%= 's' if due_soon_tasks != 1 %></span>
      </div>
    <% end %>

    <% if current_user.can_create_tasks? %>
      <%= link_to new_task_path, class: "btn btn-primary notification-item", data: { turbo_frame: "_top" } do %>
        <span class="icon icon-plus"></span>
        Nueva Tarea
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="notifications">
    <% if current_user.can_create_tasks? %>
      <%= link_to new_task_path, class: "btn btn-primary notification-item", data: { turbo_frame: "_top" } do %>
        <span class="icon icon-plus"></span>
        Nueva Tarea
      <% end %>
    <% end %>
  </div>
<% end %>

<!-- Tasks Table -->
<% if tasks.any? %>
  <div class="tasks-table">
    <table class="table">
      <thead>
        <tr>
          <th>Tarea</th>
          <th>Categoría</th>
          <th>Asignado a</th>
          <th>Prioridad</th>
          <th>Estado</th>
          <th>Fecha Límite</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% tasks.each do |task| %>
          <%= render 'task_row', task: task %>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="pagination-wrapper">
    <%= paginate tasks %>
  </div>
<% else %>
  <div class="empty-state">
    <div style="font-size: 3rem; margin-bottom: 1rem;">
      <span class="icon icon-tasks" style="font-size: 3rem; color: #9ca3af;"></span>
    </div>
    <h3>No hay tareas aún</h3>
    <% if params[:query].present? || params[:status].present? || params[:category].present? || params[:priority].present? %>
      <p>No se encontraron tareas que coincidan con los filtros seleccionados.</p>
      <%= link_to "Ver todas las tareas", tasks_path, class: "btn btn-secondary" %>
    <% elsif current_user.task_doer? %>
      <p>No tienes tareas asignadas aún. Las tareas aparecerán aquí cuando te las asignen.</p>
    <% else %>
      <p>Crea tu primera tarea para comenzar a organizarte.</p>
      <%= link_to "Crear Primera Tarea", new_task_path, class: "btn btn-primary", data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
<% end %> 