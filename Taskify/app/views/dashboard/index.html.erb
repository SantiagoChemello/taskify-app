<div class="page-header">
  <h1 class="page-title">
    ¡Hola, <%= current_user.first_name.present? ? current_user.first_name.capitalize : current_user.email.split('@').first.capitalize %>!
  </h1>
  <div class="page-actions">
    <%= link_to new_task_path, class: "btn btn-primary" do %>
      <span class="icon icon-plus"></span>
      Nueva Tarea
    <% end %>
  </div>
</div>

<!-- Quick Stats Overview -->
<div class="dashboard-stats">
  <div class="stats-grid">
    <div class="stat-card overview-card">
      <div class="stat-header">
        <h3>Resumen General</h3>
        <span class="icon icon-stats"></span>
      </div>
      <div class="stat-content">
        <div class="stat-row">
          <span class="stat-label">Total de tareas:</span>
          <span class="stat-value"><%= @total_tasks %></span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Completadas:</span>
          <span class="stat-value completed"><%= @completed_tasks %></span>
        </div>
        <div class="stat-row">
          <span class="stat-label">Pendientes:</span>
          <span class="stat-value pending"><%= @pending_tasks %></span>
        </div>
        <div class="completion-rate">
          <span class="rate-label">Tasa de completación:</span>
          <div class="progress-bar">
            <div class="progress" style="width: <%= @completion_rate %>%"></div>
          </div>
          <span class="rate-percentage"><%= @completion_rate %>%</span>
        </div>
      </div>
    </div>

    <div class="stat-card today-card">
      <div class="stat-header">
        <h3>Hoy</h3>
        <span class="icon icon-calendar"></span>
      </div>
      <div class="stat-content">
        <div class="stat-number"><%= @completed_today %></div>
        <div class="stat-description">tareas completadas</div>
        <div class="stat-secondary">
          <%= @tasks_today %> creadas hoy
        </div>
      </div>
    </div>

    <div class="stat-card week-card">
      <div class="stat-header">
        <h3>Esta Semana</h3>
        <span class="icon icon-calendar"></span>
      </div>
      <div class="stat-content">
        <div class="stat-number"><%= @tasks_this_week %></div>
        <div class="stat-description">tareas creadas</div>
      </div>
    </div>
  </div>
</div>

<!-- Notifications -->
<% if @overdue_tasks > 0 || @due_today_tasks > 0 || @due_soon_tasks > 0 %>
  <div class="dashboard-notifications">
    <div class="notifications-grid">
      <% if @overdue_tasks > 0 %>
        <div class="notification-card overdue">
          <span class="notification-icon icon icon-warning"></span>
          <div class="notification-content">
            <strong><%= @overdue_tasks %></strong>
            <span>tarea<%= 's' if @overdue_tasks != 1 %> vencida<%= 's' if @overdue_tasks != 1 %></span>
          </div>
          <%= link_to "Ver tareas", tasks_path(status: 'pending'), class: "notification-action" %>
        </div>
      <% end %>

      <% if @due_today_tasks > 0 %>
        <div class="notification-card due-today">
          <span class="notification-icon icon icon-calendar"></span>
          <div class="notification-content">
            <strong><%= @due_today_tasks %></strong>
            <span>vence<%= 'n' if @due_today_tasks != 1 %> hoy</span>
          </div>
          <%= link_to "Ver tareas", tasks_path(due_date: 'today'), class: "notification-action" %>
        </div>
      <% end %>

      <% if @due_soon_tasks > 0 %>
        <div class="notification-card due-soon">
          <span class="notification-icon icon icon-clock"></span>
          <div class="notification-content">
            <strong><%= @due_soon_tasks %></strong>
            <span>próxima<%= 's' if @due_soon_tasks != 1 %> a vencer</span>
          </div>
          <%= link_to "Ver tareas", tasks_path, class: "notification-action" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Recent Activity and Upcoming Tasks -->
<div class="dashboard-content">
  <div class="content-grid">
    <!-- Recent Tasks -->
    <div class="content-section">
      <div class="section-header">
        <h3>Actividad Reciente</h3>
        <%= link_to "Ver todas", tasks_path, class: "section-link" %>
      </div>
      <div class="tasks-list">
        <% if @recent_tasks.any? %>
          <% @recent_tasks.each do |task| %>
            <div class="task-item">
              <div class="task-status">
                <span class="status-indicator <%= task.status %>"></span>
              </div>
              <div class="task-info">
                <div class="task-title"><%= task.title %></div>
                <div class="task-meta">
                  <% if task.category.present? %>
                    <span class="task-category"><%= task.category.capitalize %></span>
                  <% end %>
                  <span class="task-time"><%= time_ago_in_words(task.updated_at) %> ago</span>
                </div>
              </div>
              <div class="task-priority">
                <span class="priority-badge priority-<%= task.priority %>">
                  <%= task.priority_label_es %>
                </span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="empty-state-small">
            <span class="empty-icon icon icon-clipboard"></span>
            <p>No hay actividad reciente</p>
            <%= link_to "Crear primera tarea", new_task_path, class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Upcoming Tasks -->
    <div class="content-section">
      <div class="section-header">
        <h3>Próximas Tareas</h3>
        <%= link_to "Ver calendario", tasks_path, class: "section-link" %>
      </div>
      <div class="tasks-list">
        <% if @upcoming_tasks.any? %>
          <% @upcoming_tasks.each do |task| %>
            <div class="task-item">
              <div class="task-status">
                <span class="status-indicator <%= task.status %>"></span>
              </div>
              <div class="task-info">
                <div class="task-title"><%= task.title %></div>
                <div class="task-meta">
                  <% if task.due_date %>
                    <span class="task-due-date">
                      <%= task.due_date.strftime('%d/%m/%Y') %>
                    </span>
                  <% end %>
                  <% if task.category.present? %>
                    <span class="task-category"><%= task.category.capitalize %></span>
                  <% end %>
                </div>
              </div>
              <div class="task-priority">
                <span class="priority-badge priority-<%= task.priority %>">
                  <%= task.priority_label_es %>
                </span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="empty-state-small">
            <span class="empty-icon icon icon-calendar"></span>
            <p>No hay tareas programadas</p>
            <%= link_to "Programar tarea", new_task_path, class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

 