<div class="auth-wrapper">
  <div class="auth-container">
    <div class="auth-card">
      <!-- Header -->
      <div class="auth-header">
        <div class="auth-logo">
          <span class="icon icon-clipboard"></span>
          <h1 class="auth-brand">Taskify</h1>
        </div>
        <h2 class="auth-title">Iniciar Sesión</h2>
        <p class="auth-subtitle">Accede a tu cuenta para gestionar tus tareas</p>
      </div>

      <!-- Form -->
      <div class="auth-form">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, class: "form", data: { turbo: false }) do |f| %>
          <div class="form-group">
            <%= f.label :email, "Correo Electrónico", class: "form-label" %>
            <%= f.email_field :email, 
                autofocus: true, 
                autocomplete: "email", 
                class: "form-input",
                placeholder: "tu@email.com" %>
          </div>

          <div class="form-group">
            <%= f.label :password, "Contraseña", class: "form-label" %>
            <div class="password-field" data-controller="password-toggle">
              <%= f.password_field :password, 
                  autocomplete: "current-password", 
                  class: "form-input",
                  placeholder: "••••••••",
                  data: { 
                    password_toggle_target: "input"
                  } %>
              <button type="button" 
                      class="password-toggle" 
                      data-action="click->password-toggle#toggle"
                      title="Mostrar/ocultar contraseña">
                <span class="icon icon-eye" data-password-toggle-target="icon"></span>
              </button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="form-group form-group--checkbox">
              <label class="checkbox-container">
                <%= f.check_box :remember_me, class: "checkbox-input" %>
                <span class="checkbox-custom"></span>
                <span class="checkbox-label">Recordarme</span>
              </label>
            </div>
          <% end %>

          <div class="form-group">
            <%= f.submit "Iniciar Sesión", class: "btn btn-primary btn-full" %>
          </div>
        <% end %>
      </div>

      <!-- Footer Links -->
      <div class="auth-footer">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
