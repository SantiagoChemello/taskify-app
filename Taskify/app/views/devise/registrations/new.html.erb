<div class="auth-wrapper">
  <div class="auth-container">
    <div class="auth-card">
      <!-- Header -->
      <div class="auth-header">
        <div class="auth-logo">
          <span class="icon icon-clipboard"></span>
          <h1 class="auth-brand">Taskify</h1>
        </div>
        <h2 class="auth-title">Crear Cuenta</h2>
        <p class="auth-subtitle">Únete y comienza a organizar tus tareas</p>
      </div>

      <!-- Form -->
      <div class="auth-form">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, class: "form") do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="form-group">
            <%= f.label :name, "Nombre Completo", class: "form-label" %>
            <%= f.text_field :name, 
                autocomplete: "name", 
                class: "form-input",
                placeholder: "Tu nombre completo" %>
          </div>

          <div class="form-group">
            <%= f.label :email, "Correo Electrónico", class: "form-label" %>
            <%= f.email_field :email, 
                autofocus: true, 
                autocomplete: "email", 
                class: "form-input",
                placeholder: "tu@email.com" %>
          </div>

          <div class="form-group">
            <%= f.label :role, "Tipo de Cuenta", class: "form-label" %>
            <%= f.select :role, 
                options_for_select([
                  ['Ejecutor de Tareas - Recibe y completa tareas asignadas', 'task_doer'],
                  ['Creador de Tareas - Crea tareas y las asigna a otros', 'task_maker'],
                  ['Administrador - Control total del sistema', 'admin']
                ], 'task_doer'), 
                {}, 
                { class: "form-select" } %>
            <small class="form-hint">
              Selecciona el tipo de cuenta según tu rol en el equipo
            </small>
          </div>

          <div class="form-group">
            <%= f.label :password, "Contraseña", class: "form-label" %>
            <% if @minimum_password_length %>
              <span class="form-hint">Mínimo <%= @minimum_password_length %> caracteres</span>
            <% end %>
            <div class="password-field" data-controller="password-toggle">
              <%= f.password_field :password, 
                  autocomplete: "new-password", 
                  class: "form-input",
                  placeholder: "••••••••",
                  data: { 
                    password_toggle_target: "input"
                  } %>
              <button type="button" 
                      class="password-toggle" 
                      data-action="click->password-toggle#toggle"
                      title="Mostrar/ocultar contraseña">
                <span class="icon icon-eye" data-password-toggle-target="icon"></span>
              </button>
            </div>
          </div>

          <div class="form-group">
            <%= f.label :password_confirmation, "Confirmar Contraseña", class: "form-label" %>
            <div class="password-field" data-controller="password-toggle">
              <%= f.password_field :password_confirmation, 
                  autocomplete: "new-password", 
                  class: "form-input",
                  placeholder: "••••••••",
                  data: { 
                    password_toggle_target: "input"
                  } %>
              <button type="button" 
                      class="password-toggle" 
                      data-action="click->password-toggle#toggle"
                      title="Mostrar/ocultar contraseña">
                <span class="icon icon-eye" data-password-toggle-target="icon"></span>
              </button>
            </div>
          </div>

          <div class="form-group">
            <%= f.submit "Crear Cuenta", class: "btn btn-primary btn-full" %>
          </div>
        <% end %>
      </div>

      <!-- Footer Links -->
      <div class="auth-footer">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
