<svg width="192" height="192" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192">
  <!-- Background circle with app's primary color -->
  <circle cx="96" cy="96" r="90" fill="#153147" stroke="#ADB8BB" stroke-width="4"/>
  
  <!-- Clipboard/task list icon -->
  <g transform="translate(96, 96)">
    <!-- Clipboard background -->
    <rect x="-34" y="-38" width="68" height="76" rx="8" fill="#F9F8F7" stroke="#EDEAE4" stroke-width="2"/>
    
    <!-- Clipboard clip -->
    <rect x="-15" y="-42" width="30" height="12" rx="4" fill="#ADB8BB"/>
    
    <!-- Checkmark lines -->
    <!-- First completed task -->
    <g stroke="#69800C" stroke-width="3" fill="none">
      <circle cx="-18" cy="-15" r="6" fill="#69800C"/>
      <path d="M-22 -15 l4 4 l8 -8" stroke="#F9F8F7" stroke-width="3"/>
    </g>
    
    <!-- Second completed task -->
    <g stroke="#69800C" stroke-width="3" fill="none">
      <circle cx="-18" cy="0" r="6" fill="#69800C"/>
      <path d="M-22 0 l4 4 l8 -8" stroke="#F9F8F7" stroke-width="3"/>
    </g>
    
    <!-- Third pending task -->
    <circle cx="-18" cy="15" r="6" fill="none" stroke="#ADB8BB" stroke-width="3"/>
    
    <!-- Task text lines -->
    <rect x="-4" y="-19" width="24" height="3" fill="#153147"/>
    <rect x="-4" y="-4" width="16" height="3" fill="#153147"/>
    <rect x="-4" y="11" width="20" height="3" fill="#ADB8BB"/>
  </g>
</svg> 